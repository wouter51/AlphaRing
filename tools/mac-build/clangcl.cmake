# Cross-compile Windows x64 DLLs on macOS: clang-cl + lld-link + xwin-splatted SDK/CRT.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(XWIN "$ENV{XWIN_DIR}")
set(CMAKE_C_COMPILER /opt/homebrew/opt/llvm/bin/clang-cl)
set(CMAKE_CXX_COMPILER /opt/homebrew/opt/llvm/bin/clang-cl)
set(CMAKE_LINKER /opt/homebrew/opt/lld/bin/lld-link)
set(CMAKE_AR /opt/homebrew/opt/llvm/bin/llvm-lib)
set(CMAKE_RC_COMPILER /opt/homebrew/opt/llvm/bin/llvm-rc)
set(CMAKE_MT /opt/homebrew/opt/llvm/bin/llvm-mt)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(_inc "/imsvc${XWIN}/crt/include /imsvc${XWIN}/sdk/include/ucrt /imsvc${XWIN}/sdk/include/um /imsvc${XWIN}/sdk/include/shared")
set(CMAKE_C_FLAGS_INIT "${_inc}")
set(CMAKE_CXX_FLAGS_INIT "${_inc} /EHsc")
set(_lib "/libpath:${XWIN}/crt/lib/x86_64 /libpath:${XWIN}/sdk/lib/um/x86_64 /libpath:${XWIN}/sdk/lib/ucrt/x86_64")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
